# Complete Collision Dashboard — web/.env.example
# Copy to .env (never committed — see .gitignore) and fill in real values.

# FastAPI backend base URL. Run the backend locally with:
#   uvicorn app.api:app --reload --port 8002
# (from the repo root, with DATABASE_URL pointed at the branch you intend
# to hit — staging for dev/testing, NEVER production from a dev machine).
# Port 8002 (not the more obvious 8000) because this repo's staging DB is
# shared with the other parallel-built dashboards on this same machine —
# 8000 collided with a concurrently-running sibling backend during this
# build; pin 8002 here so a future dev doesn't silently hit someone else's
# server or a stale process on 8000.
VITE_API_BASE_URL=http://localhost:8002

# There is no authentication on app/api.py yet (see its module docstring —
# every route is unauthenticated by design until a real auth/session
# mechanism is built). This dashboard therefore does NOT do Google OAuth
# today; it uses a lightweight "who are you" staff picker backed by
# GET/POST /staff, stored client-side only. No token/secret is needed here
# yet. This var is a placeholder for when real auth lands (see README/
# open-questions in the final report) — leave unset for now.
# VITE_GOOGLE_CLIENT_ID=
